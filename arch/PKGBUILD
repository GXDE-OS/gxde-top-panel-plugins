# Maintainer: CharOfString <root@charofstring.cc>
pkgbase=gxde-top-panel-plugins-git
pkgname=('gxde-top-panel-plugins-git' 'dde-top-panel-plugins-git')
pkgver=6.1.1
pkgrel=1
pkgdesc='Plugins for the GXDE top panel'
arch=('x86_64' 'aarch64')
url="https://github.com/GXDE-OS/gxde-top-panel-plugins"
license=('GPL-3.0-or-later')
_depends=('gxde-desktop-schemas-git' 'dtk6widget-git' 'dtk6gui-git' 'dtk6core-git' 'dframework-dbus-qt6-git'
          'gxde-network-utils-qt6-git' 'gsettings-qt6' 'libdbusmenu-lxqt' 'qt6-base' 'qt6-svg'
          'libxcb' 'xcb-util-wm' 'xcb-util-image' 'libxtst' 'libgcc' 'libstdc++' 'glibc')
makedepends=('git' 'cmake' 'ninja' 'qt6-tools' "${_depends[@]}")
source=()
sha512sums=()

# 直接使用 PKGBUILD 所在的 git 仓库作为源码 ・ Build from the git checkout this PKGBUILD lives in.
_srcroot() {
  git -C "$startdir" rev-parse --show-toplevel
}

build() {
  cmake -B build -S "$(_srcroot)" -GNinja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr
  ninja -C build
  DESTDIR="$srcdir/root" ninja -C build install
}

# 与 debian/*.install 相同，只打包两个插件目录；CMake 另外安装的 dde-dock 旧文件
# （.pc、CMake 配置、接口头文件等）在 Debian 中也未打包，且与 gxde-dock 冲突
# Same as debian/*.install: only the two plugin directories are packaged.  The
# legacy dde-dock files CMake also installs (.pc, CMake config, interface
# headers, ...) are not packaged on Debian either and collide with gxde-dock.
package_gxde-top-panel-plugins-git() {
  # qdbus-qt6 在 Arch 上由 qt6-tools 提供 ・ qdbus-qt6 comes from qt6-tools on Arch.
  depends=("${_depends[@]}" 'qt6-tools')
  provides=('gxde-top-panel-plugins')
  conflicts=('gxde-top-panel-plugins')

  install -d "$pkgdir/usr/lib/gxde-top-panel"
  cp -r "$srcdir/root/usr/lib/gxde-top-panel/plugins" "$pkgdir/usr/lib/gxde-top-panel/"
}

package_dde-top-panel-plugins-git() {
  pkgdesc='Plugins for the GXDE top panel (legacy dde-top-panel path)'
  depends=("${_depends[@]}")
  provides=('dde-top-panel-plugins')
  conflicts=('dde-top-panel-plugins')

  install -d "$pkgdir/usr/lib/dde-top-panel"
  cp -r "$srcdir/root/usr/lib/dde-top-panel/plugins" "$pkgdir/usr/lib/dde-top-panel/"
}
